# --- Database ---
# Postgres. SQLite is not an option here: this app deploys to Firebase App
# Hosting, where the filesystem is ephemeral, so a local database file would be
# empty on every deploy.
#
# Local development (docker compose up -d, then copy the printed password):
DATABASE_URL="postgresql://coursehub:coursehub@localhost:5432/coursehub?schema=public"
#
# Production (hosted, e.g. Neon):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# --- Auth ---
# 32+ random bytes. Generate with:  openssl rand -base64 32
SESSION_SECRET="dev-only-secret-change-me-in-production-0000000"

# --- Bunny Stream (optional) ---
# Leave blank to run in "no provider" mode. Video lessons will show a setup
# notice instead of a player, and everything else still works.
BUNNY_STREAM_API_KEY=""
BUNNY_STREAM_LIBRARY_ID=""
